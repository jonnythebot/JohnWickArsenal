# John Wick Arsenal - Build Environment Configuration
# Copy this file to .env and customize for your environment
# This file is gitignored - do not commit secrets!

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================
MOD_NAME=JohnWickArsenal
UNITY_VERSION=2022.3.20f1
CONFIGURATION=Release
BUILD_TARGET=Android

# Paths (auto-detected if not set)
# MOD_ROOT=/home/user/JohnWickArsenal
# UNITY_PROJECT_PATH=${MOD_ROOT}/UnityProject
# SOURCE_DIR=${MOD_ROOT}/Source/JohnWickArsenal
# ASSEMBLY_OUTPUT=${MOD_ROOT}/Assemblies
# BUNDLE_OUTPUT=${MOD_ROOT}/AssetBundles
# MOD_OUTPUT=${MOD_ROOT}/BuildOutput

# ============================================================================
# UNITY CONFIGURATION
# ============================================================================
# Explicit Unity executable path (auto-detected if not set)
# UNITY_EXECUTABLE=/opt/unity/Editor/Unity

# Additional Unity command line arguments
# UNITY_ARGS=-nographics -batchmode

# ============================================================================
# REMOTE BUILD CONFIGURATION
# ============================================================================
# Enable remote build (github, gitlab, unitycloud, custom)
# REMOTE_BUILD=false
# REMOTE_BUILD_PROVIDER=github
# REMOTE_BUILD_SCRIPT=

# GitHub Actions (requires gh CLI auth)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# GitLab CI
# GITLAB_TOKEN=glpat-xxxxxxxxxxxx
# GITLAB_PROJECT_ID=12345678

# Unity Cloud Build
# UNITY_CLOUD_BUILD_API_KEY=
# UNITY_CLOUD_BUILD_ORG_ID=
# UNITY_CLOUD_BUILD_PROJECT_ID=

# ============================================================================
# ANDROID SDK CONFIGURATION
# ============================================================================
# Android SDK path (auto-detected if not set)
# ANDROID_HOME=/home/user/Android/Sdk
# ANDROID_SDK_ROOT=/home/user/Android/Sdk

# Keystore for release builds (base64 encoded)
# ANDROID_KEYSTORE_BASE64=
# KEYSTORE_PASS=
# KEY_ALIAS=
# KEY_PASS=

# ============================================================================
# STORAGE OPTIMIZATION (Chromebook)
# ============================================================================
# Clean build outputs after successful build
# CLEAN_AFTER_BUILD=true

# Use temp directory for builds (reduces disk usage)
# USE_TEMP_DIR=true
# TEMP_BASE=/tmp/jwa-build

# ============================================================================
# LOGGING
# ============================================================================
# Log file location
# LOG_FILE=${MOD_ROOT}/build.log

# Verbose output
# VERBOSE=false

# Disable colors (for CI logs)
# NO_COLOR=false